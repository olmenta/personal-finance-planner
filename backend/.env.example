# Local Postgres 18 for dev, tests and e2e: `docker compose up -d` at the
# repo root (docker-compose.yml creates olmenta, olmenta_test, olmenta_e2e).
DATABASE_URL=postgresql+psycopg://olmenta:olmenta@localhost:5432/olmenta
MIGRATIONS_DATABASE_URL=postgresql+psycopg://olmenta:olmenta@localhost:5432/olmenta
# Tests: per-test transaction rollback, schema created by the suite
TEST_DATABASE_URL=postgresql+psycopg://olmenta:olmenta@localhost:5432/olmenta_test
# Playwright suite: it starts the API with DATABASE_URL=$E2E_DATABASE_URL and
# resets it with `uv run python -m app.e2e_reset` (npm run e2e:reset-db).
E2E_DATABASE_URL=postgresql+psycopg://olmenta:olmenta@localhost:5432/olmenta_e2e
E2E_MIGRATIONS_DATABASE_URL=postgresql+psycopg://olmenta:olmenta@localhost:5432/olmenta_e2e
# On Neon, app traffic uses the pooler host and migrations the direct host:
# DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Anthropic API (onboarding, AI category suggestions) — optional in dev;
# without it imports stage rows uncategorized and onboarding is unavailable.
ANTHROPIC_API_KEY=sk-ant-...

# LLM routes (app/llm/routes.py) — models are chosen per route; override one
# with LLM_ROUTE_<ROUTE>_MODEL, e.g.:
# LLM_ROUTE_ONBOARDING_MODEL=anthropic:claude-sonnet-5
# LLM_ROUTE_CATEGORY_SUGGESTIONS_MODEL=anthropic:claude-haiku-4-5
# LLM_ROUTE_JUDGE_MODEL=anthropic:claude-opus-5
# USD -> EUR for the costs recorded in llm_usage
LLM_USD_EUR_RATE=0.92

# Logfire (EU project) — traces, LLM observability, eval experiments. Dormant
# without a token. LLM prompts/outputs are NEVER exported in production;
# elsewhere only with LOGFIRE_INCLUDE_CONTENT=true (your own dev project/data).
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
LOGFIRE_INCLUDE_CONTENT=false

# Sentry — optional; SDK stays dormant without a DSN. No PII is ever sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Forward Python logging to Sentry Logs (warnings and up)
SENTRY_ENABLE_LOGS=true
# Sentry PII (request data). Forced off in production regardless (GDPR).
SENTRY_SEND_DEFAULT_PII=false
# Traces belong to Logfire; keep Sentry tracing off unless debugging.
SENTRY_TRACES_SAMPLE_RATE=0.0
