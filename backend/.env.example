# Neon dev environment — fill in the password, never commit .env
# App traffic goes through the pooler; Alembic uses the direct host.
DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-little-hill-ab4lvwvf-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
MIGRATIONS_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-little-hill-ab4lvwvf.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Dedicated Neon branch/database for tests (per-test transaction rollback)
TEST_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-little-hill-ab4lvwvf.eu-west-2.aws.neon.tech/neondb_test?sslmode=require
# Neon "e2e" branch (schema-only from production, no personal data) for the
# future Playwright suite: it starts the API with DATABASE_URL=$E2E_DATABASE_URL
# and resets it with `uv run python -m app.e2e_reset` (npm run e2e:reset-db).
E2E_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-frosty-bird-abmrugte-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
E2E_MIGRATIONS_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@ep-frosty-bird-abmrugte.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Anthropic API (AI category suggestions during imports) — optional in dev;
# without it imports stage rows uncategorized.
ANTHROPIC_API_KEY=sk-ant-...

# Confident AI (DeepEval) — LLM telemetry + eval runs (llm-observability-evals change)
CONFIDENT_API_KEY=

# Sentry — optional; SDK stays dormant without a DSN. No PII is ever sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Forward Python logging to Sentry Logs (warnings and up)
SENTRY_ENABLE_LOGS=true
# LLM prompts/completions inside Sentry gen-AI spans. DEV ONLY —
# forced off in production regardless of this flag (GDPR).
SENTRY_SEND_DEFAULT_PII=true
# 1.0 captures every transaction for tracing (dev); lower in prod.
SENTRY_TRACES_SAMPLE_RATE=0.1
