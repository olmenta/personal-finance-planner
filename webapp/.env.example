# FastAPI backend base URL for the BFF Route Handlers (server-side only —
# never NEXT_PUBLIC_). Local default matches `uv run uvicorn app.main:app --reload`.
BACKEND_URL=http://localhost:8000

# Sentry — all optional; without a DSN the SDK stays dormant.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map upload during `next build` (CI); skipped when unset.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Environment: local | test | dev | beta | prod. Without AUTH0_DOMAIN, local
# and test run without login as the development user; anywhere else the
# Auth0 variables are required (docs/auth0-setup.md).
APP_ENV=local
# Auth0 (server-only). APP_BASE_URL is this deployment's URL, or a
# comma-separated list when one server answers on several (local plus the
# dev tunnel, docs/dev-tunnel.md); AUTH0_AUDIENCE
# is this environment's API identifier (https://api-dev.olmenta.com,
# https://api-beta.olmenta.com, https://api.olmenta.com).
# AUTH0_DOMAIN=olmenta.eu.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=   # 32+ random bytes: openssl rand -hex 32
# APP_BASE_URL=http://localhost:3000,https://dev.olmenta.com
# AUTH0_AUDIENCE=https://api-dev.olmenta.com
