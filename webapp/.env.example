# FastAPI backend base URL for the BFF Route Handlers (server-side only —
# never NEXT_PUBLIC_). Local default matches `uv run uvicorn app.main:app --reload`.
BACKEND_URL=http://localhost:8000

# Sentry — all optional; without a DSN the SDK stays dormant.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map upload during `next build` (CI); skipped when unset.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
